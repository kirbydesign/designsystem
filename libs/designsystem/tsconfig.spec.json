{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": ["jasmine", "node"],
    "strictPropertyInitialization": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "paths": {
      "@kirbydesign/core": ["../core/src/index.ts"],
      "@kirbydesign/extensions-angular/image-banner": [
        "../extensions/angular/image-banner/index.ts"
      ],
      "@kirbydesign/extensions-angular/skeleton-loader": [
        "../extensions/angular/skeleton-loader/index.ts"
      ],
      "@kirbydesign/designsystem": ["./src/public-api.ts"],
      "@kirbydesign/designsystem/testing-base": ["./testing-base/src/public_api.ts"],
      "@kirbydesign/designsystem/testing-jasmine": ["./testing-jasmine/src/public_api.ts"],
      "@kirbydesign/designsystem/*": ["./*/index.ts"]
    }
  },
  "files": ["test.ts"],
  "include": ["**/*.spec.ts", "**/*.d.ts"],
  "exclude": []
}
