{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "~/app/*": ["../../../apps/cookbook/src/app/*"],
      "~/environments/*": ["../../../apps/cookbook/src/environments/*"]
    },
    "strict": false,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "noImplicitAny": false
  },
  "exclude": ["../**/*.spec.ts", "../testing*/**"],
  "include": ["../**/*.stories.ts", "../**/*.mdx", "*.js", "*.ts"]
}
