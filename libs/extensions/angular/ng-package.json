{
  "$schema": "../../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "dist/",
  "allowedNonPeerDependencies": [
    "@tiptap/core",
    "@tiptap/starter-kit",
    "prosemirror-commands",
    "prosemirror-history",
    "prosemirror-keymap",
    "prosemirror-model",
    "prosemirror-schema-basic",
    "prosemirror-schema-list",
    "prosemirror-state",
    "prosemirror-view"
  ],
  "lib": {
    "entryFile": "index.ts"
  },
  "assets": [
    {
      "input": "spot-illustration/src/svgs",
      "glob": "**/*.svg",
      "output": "assets/spot-illustrations"
    }
  ]
}
