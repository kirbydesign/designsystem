{
  "compilerOptions": {
    "outDir": "./dist",
    "module": "ESNext",
    "target": "ES2017",
    "moduleResolution": "node",
    "types": ["node"],
    "lib": ["es2017", "dom"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "noUncheckedSideEffectImports": false,
    "ignoreDeprecations": "6.0",
    "rootDir": "."
  }
}
